{
  "schemaVersion": 1,
  "id": "emissivetexture",
  "version": "1.0",
  "name": "Emissivetexture",
  "description": "Automatically renders *_e.png resource pack textures as pixel-accurate, full-bright emissive textures.",
  "authors": ["kazut0"],
  "contact": {
    "issues": "https://dsc.gg/kazut0",
    "homepage": "https://modrinth.com/mod/eazydye"
  },
  "license": "MIT",
  "icon": "assets/emissivetexture/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "net.kztmc.mc.emissivetexture.EmissivetextureClient"
    ]
  },
  "mixins": [
    "emissivetexture.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_version}"
  }
}
